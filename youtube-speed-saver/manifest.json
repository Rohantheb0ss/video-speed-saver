{
  "manifest_version": 3,
  "name": "Video Speed Saver",
  "version": "1.1.1",
  "description": "Shows how much time you save by watching videos at the current playback speed.",
  "icons": {
    "16": "icons/speed-saver-16.png",
    "32": "icons/speed-saver-32.png",
    "48": "icons/speed-saver-48.png",
    "128": "icons/speed-saver-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Video Speed Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/speed-saver-16.png",
      "32": "icons/speed-saver-32.png",
      "48": "icons/speed-saver-48.png",
      "128": "icons/speed-saver-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
